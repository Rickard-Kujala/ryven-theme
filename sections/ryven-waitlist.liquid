{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<section
  id="ryven-waitlist"
  class="ryven-waitlist spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  tabindex="-1"
>
  <div class="ryven-waitlist__inner section section--page-width">
    {% if section.settings.eyebrow != blank %}
      <p class="ryven-waitlist__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="ryven-waitlist__heading h2">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="ryven-waitlist__subheading">{{ section.settings.subheading | escape }}</p>
    {% endif %}

    {%- form 'customer', id: 'ryven-waitlist-form', class: 'ryven-waitlist__form' -%}
      {{ form.errors | default_errors }}

      {%- if form.posted_successfully? -%}
        <p class="ryven-waitlist__success" role="alert" tabindex="-1">
          You're on the list — we'll notify you at launch.
        </p>
      {%- else -%}
        <div class="ryven-waitlist__row">
          <label for="ryven-waitlist-email" class="visually-hidden">Email address</label>
          <input
            type="email"
            id="ryven-waitlist-email"
            name="contact[email]"
            class="ryven-waitlist__input"
            placeholder="{{ section.settings.input_placeholder | escape }}"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
          >
          <input type="hidden" name="contact[tags]" value="waitlist">
          <button type="submit" class="ryven-waitlist__submit button">
            {{ section.settings.button_label | escape }}
          </button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

<script>
  (function () {
    'use strict';
    document.querySelectorAll('a[href="#ryven-waitlist"]').forEach(function (link) {
      link.addEventListener('click', function () {
        var input = document.getElementById('ryven-waitlist-email');
        if (input) { setTimeout(function () { input.focus(); }, 380); }
      });
    });
  }());
</script>

{% stylesheet %}
  .ryven-waitlist {
    outline: none;
  }

  .ryven-waitlist__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }

  .ryven-waitlist__eyebrow {
    margin: 0;
    font-family: var(--font-accent--family, var(--font-body--family));
    font-size: 0.6875rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    opacity: 0.45;
  }

  .ryven-waitlist__heading {
    margin: 0;
    max-width: 560px;
  }

  .ryven-waitlist__subheading {
    margin: 0;
    opacity: 0.55;
    max-width: 480px;
  }

  .ryven-waitlist__form {
    width: 100%;
    max-width: 480px;
  }

  .ryven-waitlist__row {
    display: flex;
    gap: 12px;
    align-items: stretch;
  }

  @media screen and (max-width: 749px) {
    .ryven-waitlist__row {
      flex-direction: column;
    }
  }

  .ryven-waitlist__input {
    flex: 1;
    min-width: 0;
    padding: 13px 20px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 100px;
    background: transparent;
    color: var(--color-foreground);
    font-size: 0.875rem;
    line-height: 1.5;
    transition: border-color 0.3s ease;
  }

  .ryven-waitlist__input::placeholder {
    color: rgb(var(--color-foreground-rgb) / 0.4);
  }

  .ryven-waitlist__input:focus-visible {
    outline: 2px solid rgb(var(--color-foreground-rgb) / 0.25);
    outline-offset: 2px;
    border-color: rgb(var(--color-foreground-rgb) / 0.55);
  }

  .ryven-waitlist__submit {
    padding-inline: 32px;
    padding-block: 13px;
    border-radius: 100px;
    white-space: nowrap;
    pointer-events: auto;
  }

  @media screen and (max-width: 749px) {
    .ryven-waitlist__submit {
      width: 100%;
    }
  }

  .ryven-waitlist__success {
    margin: 0;
    color: #7CFF6B;
    font-size: 0.875rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ryven Waitlist",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "— Waitlist"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Be the first to know"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium football accessories, launching soon."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join the Waitlist"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": []
}
{% endschema %}
