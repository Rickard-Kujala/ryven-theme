{
  "sections": {
    "coming_soon_hero": {
      "type": "coming-soon-hero",
      "blocks": {
        "kicker": {
          "type": "text",
          "settings": {
            "text": "<p>Performance Football</p>",
            "text_color": "{{ settings.color_palette.color1 }}",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-accent--family)",
            "font_size": "0.875rem",
            "line_height": "normal",
            "letter_spacing": "loose",
            "case": "uppercase",
            "wrap": "pretty",
            "padding-block-end": 8
          }
        },
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h1>Built For Players Who Want More.</h1>",
            "text_color": "{{ settings.color_palette.background }}",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "h1"
          }
        },
        "subheading": {
          "type": "text",
          "settings": {
            "text": "<p>Premium football accessories engineered for players who demand performance, confidence and precision.</p>",
            "text_color": "{{ settings.color_palette.background }}",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "rte",
            "padding-block-end": 16
          }
        },
        "buttons": {
          "type": "group",
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": true,
            "horizontal_alignment": "center",
            "vertical_alignment": "center",
            "gap": 16,
            "width": "fit-content",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "background_media": "none",
            "border": "none",
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "primary_button": {
              "type": "button",
              "settings": {
                "label": "Notify Me",
                "link": "#shopify-section-email_signup",
                "open_in_new_tab": false,
                "style_class": "button-custom",
                "custom_button_background": "{{ settings.color_palette.color1 }}",
                "custom_button_text": "{{ settings.color_palette.foreground }}",
                "custom_button_border": "{{ settings.color_palette.color1 }}",
                "width": "fit-content",
                "width_mobile": "fill"
              }
            },
            "secondary_button": {
              "type": "button",
              "settings": {
                "label": "Our Story",
                "link": "#shopify-section-mission",
                "open_in_new_tab": false,
                "style_class": "button-custom",
                "custom_button_background": "rgba(0,0,0,0)",
                "custom_button_text": "{{ settings.color_palette.background }}",
                "custom_button_border": "{{ settings.color_palette.background }}",
                "width": "fit-content",
                "width_mobile": "fill"
              }
            }
          },
          "block_order": ["primary_button", "secondary_button"]
        }
      },
      "block_order": ["kicker", "heading", "subheading", "buttons"],
      "settings": {
        "brand_name": "RYVEN",
        "background_media": "none",
        "content_direction": "column",
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 24,
        "section_width": "full-width",
        "section_height": "full-screen",
        "background_color": "{{ settings.color_palette.foreground }}",
        "toggle_overlay": true,
        "overlay_color": "#0A0A0A99",
        "overlay_style": "solid",
        "show_scroll_indicator": true,
        "padding-block-start": 60,
        "padding-block-end": 60
      }
    },
    "coming_soon_countdown": {
      "type": "coming-soon-countdown",
      "blocks": {},
